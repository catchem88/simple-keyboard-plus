<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:fullBackupOnly="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/english_ime_name"
        android:supportsRtl="true">

        <service
            android:name=".latin.LatinIME"
            android:label="@string/english_ime_name"
            android:directBootAware="true"
            android:exported="false"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Kept exported with no intent filter because the system Settings app launches it
             directly by component name through android:settingsActivity in xml/method.xml. The
             launcher entry lives on the alias below instead. -->
        <activity
            android:name=".latin.settings.SettingsActivity"
            android:label="@string/english_ime_name"
            android:exported="true"
            android:theme="@style/platformSettingsTheme" />

        <!-- The launcher entry is an alias so that it can be switched off at runtime with
             PackageManager.setComponentEnabledSetting, which cannot be done to an activity that the
             system also needs to launch. Enabled by default so a fresh install is still
             discoverable; the "Show app icon" preference disables it. -->
        <activity-alias
            android:name=".latin.settings.SettingsLauncherAlias"
            android:targetActivity=".latin.settings.SettingsActivity"
            android:label="@string/english_ime_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".latin.SystemBroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <meta-data android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/app_restrictions" />
    </application>

</manifest>